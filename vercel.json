{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "CONTENT_GOVERNANCE_ENABLED": "true"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_CONTENT_APPEALS_ENABLED": "true"
    }
  },
  "regions": [
    "fra1"
  ],
  "functions": {
    "src/app/api/**": {
      "maxDuration": 30
    },
    "src/app/api/admin/generate-questions/**": {
      "maxDuration": 120
    },
    "src/app/api/cron/**": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/daily-streak-reminder",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/honeypot-check",
      "schedule": "0 */6 * * *"
    }
  ]
}
