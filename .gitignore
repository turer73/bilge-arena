# Soru bankasi veri dosyalari (full dataset DB'de, repo'da olmamali)
data/soru-bankasi/
wordquest/data/*
# Sample dosyasi istisna — dev seed testi icin gerekli (~20 soru)
!wordquest/data/questions-sample.json
# Private klasor — full dataset ve diger gizli assetler
/private/

# PWA build artifacts (auto-generated by next-pwa):
# - public/sw.js IGNORED — Codex PR #108 P1: sw.js precache manifest icinde
#   build-specific URL'ler ('/_next/static/<BUILD_ID>/...') hardcoded. Lokal
#   commit + Vercel build farkli BUILD_ID = workbox install fail
#   ('bad-precaching-response') = SW activate ETMEZ = PWA broken.
#   Cozum: sw.js'i commit etme, Vercel build kendi BUILD_ID'siyle deploy
#   time'da uretsin. Vercel public/'i build sonrasi serve eder.
# - workbox-*.js + swe-worker-*.js + fallback-*.js commit edilmis kalir
#   (next-pwa runtime cache helper'lari, build_id'den bagimsiz).
public/sw.js
public/sw.js.map

# Playwright e2e artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Vitest coverage (lcov + html, codecov upload icin lokal artifact)
/coverage/

# VPS infra secrets (DB passwords, JWT secrets, env files - VPS-only)
infra/vps/*/secrets/*.env
infra/vps/*/secrets/*.json
!infra/vps/*/secrets/.gitkeep
