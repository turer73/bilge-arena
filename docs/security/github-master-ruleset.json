{
  "name": "master protection",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/master"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ],
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "🔐 Lockfile platform guard"
          },
          {
            "context": "🔍 Lint"
          },
          {
            "context": "🔒 Type Check"
          },
          {
            "context": "🧪 Test"
          },
          {
            "context": "🏫 Institution pilot PostgreSQL"
          },
          {
            "context": "🧭 Question quality PostgreSQL"
          },
          {
            "context": "🏗️ Build"
          },
          {
            "context": "🎭 E2E (chromium)"
          },
          {
            "context": "Dependency review"
          },
          {
            "context": "CodeQL (actions)"
          },
          {
            "context": "CodeQL (javascript-typescript)"
          }
        ],
        "strict_required_status_checks_policy": true
      }
    }
  ]
}
