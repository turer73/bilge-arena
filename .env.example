# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ana sayfa misafir mikro-quiz XP bileti (service-role anahtarindan ayri, min 32 karakter)
# NEXT_PUBLIC_ACTIVATION_EXPERIMENT_ENABLED=false
# ACTIVATION_EXPERIMENT_ENABLED=false
# ACTIVATION_REWARD_SECRET=<openssl rand -hex 32>

# AI Chat (Faz 7)
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENERATIVE_AI_API_KEY=AIxxx...   (Gemini, chat ve admin/generate-questions icin zorunlu)
# NEXT_PUBLIC_COACH_ENABLED=false  (UI kill switch; migration ve pilot onayi sonrasi true)
# COACH_ENABLED=false  (server kill switch; migration ve pilot onayi sonrasi true)
# COACH_AI_ENABLED=false  (ucuncu taraf model; veri-isleme/retention/region onayi sonrasi true)
# NEXT_PUBLIC_BILGE_TAHTA_ENABLED=false  (oyun ve Ders Calis ortak tahta UI kill switch)
# COACH_TOKEN_SECRET=<openssl rand -hex 32>  (Bilge Koc asama tokeni; service-role anahtarindan ayri ve zorunlu)
# Bilge Koc AI ipuclari DEEPSEEK_API_KEY kullanir (chat ile ayni saglayici, model
# deepseek-v4-flash). Genel DeepSeek anahtari tek basina Koc AI'ini etkinlestirmez:
# COACH_AI_ENABLED=true ayrica gereklidir. Anahtar yoksa ipucu 'fallback'e duser.
# NEXT_PUBLIC_MOCK_STRATEGY_ENABLED=false  (Akilli Deneme strateji UI kill switch)
# MOCK_STRATEGY_ENABLED=false  (server/API kill switch; DB deneyi ayrica active olmalidir)
# NEXT_PUBLIC_SOCIAL_LEAGUE_ENABLED=false  (yakin-rakip haftalik lig UI kill switch)
# SOCIAL_LEAGUE_ENABLED=false  (lig API/cron kill switch; migration ve pilot onayi sonrasi true)
# NEXT_PUBLIC_SOCIAL_SPOTLIGHTS_ENABLED=false  (olumlu gelisim/duzen/geri-donus UI kill switch)
# SOCIAL_SPOTLIGHTS_ENABLED=false  (spotlight API kill switch; SOCIAL_LEAGUE_ENABLED da true olmalidir)
# NEXT_PUBLIC_SOCIAL_TEAM_BOSS_ENABLED=false  (ortak kohort bossu UI kill switch)
# SOCIAL_TEAM_BOSS_ENABLED=false  (takim bossu API kill switch; SOCIAL_LEAGUE_ENABLED da true olmalidir)
# NEXT_PUBLIC_PAPER_MODE_ENABLED=false  (kisisel kagit/PDF paketi UI kill switch)
# PAPER_MODE_ENABLED=false  (paper-pack issue/read/submit API kill switch; pilot onayi sonrasi true)
# NEXT_PUBLIC_TEACHER_CLASSROOM_ENABLED=false  (ogrenci/ogretmen sinif UI kill switch)
# TEACHER_CLASSROOM_ENABLED=false  (sinif/odev API kill switch; hukuki ve pilot onayi sonrasi true)
# TEACHER_CLASSROOM_INVITE_SECRET=<openssl rand -hex 32>  (service-role anahtarindan ayri)
# TEACHER_CLASSROOM_NOTICE_VERSION=notice-v1
# TEACHER_CLASSROOM_NOTICE_URL=https://bilgearena.com/hukuk/sinif-aydinlatma
# TEACHER_CLASSROOM_CONSENT_VERSION=sharing-v1
# TEACHER_CLASSROOM_CONSENT_URL=https://bilgearena.com/hukuk/sinif-paylasim-rizasi
# INSTITUTION_PILOT_ENABLED=false  (kurum tenant/personel API ana kapisi)
# INSTITUTION_ONBOARDING_ENABLED=false  (yeni ucretli kurum olusturma kill switch; acik onay olmadan true yapilmaz)
# INSTITUTION_FREE_PILOT_ENABLED=false  (yalniz admin UI/API yuzeyi; DB free_provisioning kontrolu de acik olmalidir; en fazla 40 ogrenci/2 personel, ucretli onboarding'i acmaz)
# INSTITUTION_TRACKING_ENABLED=false  (kurum ogrenci analiz API kapisi; pilot kapisi da true olmalidir)
# NEXT_PUBLIC_INSTITUTION_TRACKING_ENABLED=false  (kurum takip UI kill switch; UI diliminde kullanilacak)
# INSTITUTION_STUDY_PROGRAM_ENABLED=false  (ogretmen taslak/yayin program yazma kapisi)
# INSTITUTION_DEMO_ENABLED=false  (yalniz sentetik /arena/kurum/demo sunumu; production varsayilan kapali)
# NEXT_PUBLIC_CONTENT_APPEALS_ENABLED=false  (ogrenci itiraz/düzeltme UI kill switch)
# CONTENT_GOVERNANCE_ENABLED=false  (revizyon, iki asamali onay, itiraz ve düzeltme API kill switch)
# CHAT_SYSTEM_PROMPT="Sen bir YKS asistanisin..."  (opsiyonel; yoksa generic fallback kullanilir)
# QUESTION_GEN_PROMPT_TEMPLATE="Sen deneyimli bir YKS soru yazarisin..."
#   (opsiyonel; admin/generate-questions icin prompt template.
#    Placeholders: {categoryLabel}, {langRule}, {topicList}.
#    Yoksa generic fallback kullanilir; soru kalitesi dusuk olur.)

# Upstash Redis — Rate limiting (production'da zorunlu; localde yoksa in-memory fallback)
# URL + TOKEN ayni aileden birlikte set edilmeli. Vercel entegrasyonu KV_REST_API_*,
# manuel Upstash kurulumu UPSTASH_REDIS_REST_* adlarini kullanir:
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...
# KV_REST_API_URL=https://xxx.upstash.io  (Vercel otomatik ekler)
# KV_REST_API_TOKEN=AXxx...               (Vercel otomatik ekler)

# FSRS genel quiz rollout (server-only; varsayilan kapali / fail-closed)
# FSRS_REVIEW_ENABLED=false
# FSRS_REVIEW_ROLLOUT_PERCENT=0  # 0-100 tam sayi; ayni kullanici kararlı kohortta kalir
# FSRS_REVIEW_KILL_SWITCH=false # true: enabled/yuzdeden bagimsiz acil kapatma

# Push Notifications (VAPID)
# npx web-push generate-vapid-keys ile uret
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BLxx...
# VAPID_PRIVATE_KEY=xxx...
# VAPID_EMAIL=mailto:iletisim@bilgearena.com

# Resend — Email (haftalik ozet icin)
# RESEND_API_KEY=re_xxx...

# Cron Secret — Vercel Cron guvenlik token'i
# CRON_SECRET=random-secret-string

# Google AdSense
# NEXT_PUBLIC_ADSENSE_ID=ca-pub-xxxxxxxxxxxxx

# Sentry — https://sentry.io projesinden DSN al
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=bilge-arena
